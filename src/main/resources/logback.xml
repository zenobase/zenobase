<configuration>

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%date [%level] %logger - [%X{method} %X{path}] [%X{userId}] %message%n%xException</pattern>
		</encoder>
	</appender>

	<logger name="com.zenobase" level="DEBUG"/>

	<root level="WARN">
		<appender-ref ref="STDOUT"/>
	</root>

</configuration>
