# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

POST    /signin                                AuthenticationController.signIn
POST    /signout                               AuthenticationController.signOut

GET     /                                      staticFile:public/index.html

# Home page
GET     /buckets/                              DashboardController.get
POST    /buckets/                              DashboardController.post

GET     /queue/                                QueueController.get
POST    /queue/{<[-\w]{8}>id}                  QueueController.post

# GET     /terms                               TemplateController.get(template:'legal/terms.html')
# GET     /privacy                             TemplateController.get(template:'legal/privacy.html')

GET     /buckets/{<[-\w]{8}>bucketId}/         BucketController.get
POST    /buckets/{<[-\w]{8}>bucketId}/         BucketController.post
DELETE  /buckets/{<[-\w]{8}>bucketId}/         BucketController.delete

GET     /buckets/{<[-\w]{8}>bucketId}/{<[-\w]{8}>eventId}  EventController.get

# Ignore favicon requests
GET     /favicon.ico                           404

# Map static resources from the /app/public folder to the /public path
GET     /public/                               staticDir:public

# Import Secure routes
*       /                                      module:secure
