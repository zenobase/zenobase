# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# Home page
GET     /                                       DashboardController.get
POST    /                                       DashboardController.post

POST    /queue                                  QueueController.post

GET     /terms                                  TemplateController.get(template:'legal/terms.html')
GET     /privacy                                TemplateController.get(template:'legal/privacy.html')

GET     /{<[-\w]{22}>bucketId}/                 BucketController.get
POST    /{<[-\w]{22}>bucketId}/                 BucketController.post
DELETE  /{<[-\w]{22}>bucketId}/                 BucketController.delete

GET     /{<[-\w]{22}>bucketId}/{<[-\w]{22}>eventId}          EventController.get
GET     /{<[-\w]{22}>bucketId}/{<[-\w]{22}>eventId}.{format} EventController.get

# Ignore favicon requests
GET     /favicon.ico                            404

# Map static resources from the /app/public folder to the /public path
GET     /public/                                staticDir:public

# Import Secure routes
*       /                                       module:secure
