# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# Home page
GET     /                            controllers.Assets.at(path="/public", file="index.html")
GET     /admin                       controllers.Assets.at(path="/public", file="admin.html")

GET     /who                         controllers.UserController.who()
GET     /users/                      controllers.UserController.find(identity ?= null, offset : Int ?= 0, limit : Int ?= java.lang.Integer.MAX_VALUE)
GET     /users/:name                 controllers.UserController.get(name)

POST    /users/                      controllers.AccountController.open()
DELETE  /users/:name                 controllers.AccountController.close(name)

POST    /signin                      controllers.SecurityController.signIn()
POST    /signout                     controllers.SecurityController.signOut()

GET     /buckets/                    controllers.BucketListController.get(identity ?= null)
POST    /buckets/                    controllers.BucketListController.post()

GET     /buckets/:bucketId/          controllers.BucketController.get(bucketId)
POST    /buckets/:bucketId/          controllers.BucketController.post(bucketId)
DELETE  /buckets/:bucketId/          controllers.BucketController.delete(bucketId)

GET     /buckets/:bucketId/:eventId  controllers.EventController.get(bucketId, eventId)
DELETE  /buckets/:bucketId/:eventId  controllers.EventController.delete(bucketId, eventId)

GET     /queue/                      controllers.QueueController.get(offset : Int, limit : Int)
POST    /queue/:id                   controllers.QueueController.post(id)

# Ignore favicon requests
GET     /favicon.ico                 controllers.Default.notFound
GET     /b/                          controllers.Default.redirect(to = "/buckets/") 


# Map static resources from the /public folder to the /assets URL path
GET     /public/*file                controllers.Assets.at(path="/public", file)
