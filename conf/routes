GET     /test                        com.zenobase.controllers.TemplateController.index()

GET     /                            com.zenobase.controllers.Assets.at(path="/public", file="index.html")
GET     /admin/                      com.zenobase.controllers.Assets.at(path="/public/admin", file="index.html")
GET     /status                      com.zenobase.controllers.StatusController.get()

GET     /who                         com.zenobase.controllers.WhoController.who()
POST    /signin                      com.zenobase.controllers.SecurityController.signIn()
POST    /signout                     com.zenobase.controllers.SecurityController.signOut()
POST    /reset                       com.zenobase.controllers.PasswordResetController.requestReset()

GET     /users/                      com.zenobase.controllers.UserListController.find(identity ?= null, offset : Int ?= 0, limit : Int ?= java.lang.Integer.MAX_VALUE)
GET     /users/:name                 com.zenobase.controllers.UserController.get(name)
POST    /users/:name                 com.zenobase.controllers.UserController.update(name)

POST    /users/                      com.zenobase.controllers.AccountController.open()
DELETE  /users/:name                 com.zenobase.controllers.AccountController.close(name)

GET     /buckets/                    com.zenobase.controllers.BucketListController.find(identity ?= null, offset : Int ?= 0, limit : Int ?= java.lang.Integer.MAX_VALUE)
POST    /buckets/                    com.zenobase.controllers.BucketListController.post()

GET     /buckets/:bucketId           com.zenobase.controllers.BucketController.get(bucketId)
POST    /buckets/:bucketId           com.zenobase.controllers.BucketController.update(bucketId)
DELETE  /buckets/:bucketId           com.zenobase.controllers.BucketController.delete(bucketId)

GET     /buckets/:bucketId/          com.zenobase.controllers.EventListController.get(bucketId)
POST    /buckets/:bucketId/          com.zenobase.controllers.EventListController.post(bucketId)

GET     /buckets/:bucketId/:eventId  com.zenobase.controllers.EventController.get(bucketId, eventId)
POST    /buckets/:bucketId/:eventId  com.zenobase.controllers.EventController.update(bucketId, eventId)
DELETE  /buckets/:bucketId/:eventId  com.zenobase.controllers.EventController.delete(bucketId, eventId)

GET     /queue/                      com.zenobase.controllers.QueueController.get(offset : Int, limit : Int)
POST    /queue/                      com.zenobase.controllers.QueueController.post()

GET     /*file                       com.zenobase.controllers.Assets.at(path="/public", file)
