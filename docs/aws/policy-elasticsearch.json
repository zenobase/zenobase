{
  "Statement": [
    {
      "Action": [
        "s3:*"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::zeno-elasticsearch",
        "arn:aws:s3:::zeno-elasticsearch/*"
      ]
    }
  ],
  "Statement": [
    {
      "Action": "EC2:Describe*",
      "Effect": "Allow",
      "Resource": [
        "*"
      ]
    }
  ],
  "Statement": [
    {
      "Action": [
        "elasticloadbalancing:DeregisterInstancesFromLoadBalancer",
        "elasticloadbalancing:RegisterInstancesWithLoadBalancer"
      ],
      "Effect": "Allow",
      "Resource": [
        "*"
      ]
    }
  ]
}
